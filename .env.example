# Copy to .env:  cp .env.example .env

# Secret for signing JWT tokens — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Port the app is available on: http://localhost:8080
APP_PORT=8080
# Public URL of the app (used for CORS). On a server: https://your-domain.com
PUBLIC_URL=http://localhost:8080
# true when the app is served over HTTPS
COOKIE_SECURE=false

# MySQL
DB_USER=inventory
DB_PASSWORD=inventory
MYSQL_ROOT_PASSWORD=root
# Host port for MySQL Workbench (bound to 127.0.0.1 only)
DB_PORT=3307

# Currencies for product prices (ISO codes) and the one shown as the main price
CURRENCIES=UAH,USD
DEFAULT_CURRENCY=UAH
# Max size of an uploaded product photo, MB
UPLOAD_MAX_MB=2

# Demo credentials shown on the login page (leave empty to hide the hint)
DEMO_EMAIL=admin@inventory.local
DEMO_PASSWORD=Admin123!
